# Banco de dados — Vercel Postgres (Neon). Adicionar em Vercel > projeto > Storage > Postgres,
# a Vercel injeta essa variável sozinha (não precisa copiar manualmente em produção).
DATABASE_URL=

# Upload de imagem de produto — Vercel > projeto > Storage > Blob.
BLOB_READ_WRITE_TOKEN=

# Mercado Pago — painel de desenvolvedor da conta de negócio da Zantte.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Melhor Envio — cálculo de frete/prazo real pros produtos de envio próprio.
# Token gerado em melhorenvio.com.br > Integrações > Tokens (permissão shipping-calculate).
MELHOR_ENVIO_TOKEN=
# CEP de onde os produtos "envio próprio" são despachados.
MELHOR_ENVIO_ORIGIN_CEP=

# Resend — envio de e-mail de status de pedido (pedido enviado/entregue).
RESEND_API_KEY=
RESEND_FROM_EMAIL=loja@zantte.com.br

# Painel admin (/admin) — senha escolhida pela dona do site.
ADMIN_PASSWORD=
# Gerar com: openssl rand -base64 32
SESSION_SECRET=

# URL pública do site — usada nos back_urls do Mercado Pago e no link de rastreio nos e-mails.
NEXT_PUBLIC_SITE_URL=https://zantte.com.br

# Meta Pixel (Facebook/Instagram Ads) — ID do conjunto de dados no Gestor de Eventos.
NEXT_PUBLIC_META_PIXEL_ID=
